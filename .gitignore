# analysis/ownership/ scripts are tracked deliberately (resolved 2026-08-17): the .py files
# are committed, their results/ outputs fall under the *.csv / *.json rules below.

# Built report artifacts. The .tex prose and the generator are tracked; everything the
# generator or LaTeX produces is not — regenerate with:
#   python <report>/paper/scripts/generate_paper_assets.py && pdflatex Report.tex
**/paper/*.pdf
**/paper/figures/*.pdf
**/paper/tables/*.tex
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc

# Common data file extensions
*.csv
*.xlsx
*.xls
*.parquet
*.pmtiles
*.json
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.png

# Philadelphia webmap: the JS/Python agreement fixture must be committed, but
# *.json is ignored repo-wide above, so it needs an explicit negation.
!tests/fixtures/
!tests/fixtures/*.json

# Report letterhead logos are source assets, not generated output — same *.png exception.
!**/paper/figures/ppi-logo.png

